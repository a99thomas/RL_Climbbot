<mujoco model="climbbot_scene_v7_ladder">
  <include file="robot_v7.xml"/>

  <visual>
    <quality shadowsize="0"/>
    <map znear="0.01" zfar="50"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.4 0.4 0.4"/>
    <global fovy="89.16" offwidth="1280" offheight="720" azimuth="-150" elevation="-40"/>
  </visual>

  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

  <default>
    <default class="world_collision">
      <geom material="collision_material" condim="4" contype="1" conaffinity="15" priority="2"
            solref="0.01 1" solimp="0.97 0.999 0.0005" friction="2.0 0.1 0.05"/>
    </default>
  </default>

  <compiler angle="radian"/>

  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="wall_material" rgba="0.6 0.6 0.6 1"/>
    <material name="rung_material" rgba="0.2 0.8 0.3 1"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" pos="0 0 -0.6" friction="1.0"/>

    <body name="climbing_wall" pos="0 0 0" euler="-1.57 1.57 0">
    <body name="climbing_wall_tilted" pos="0 0 0" euler="1.57 0 0">
      <geom name="wall_board" type="box" size="1.0 0.05 1.5" pos="0 0.045 1.5"
            material="wall_material" class="world_collision"/>

      <!-- LADDER: rungs every 0.2 m on BOTH sides. Same-side gap = 0.2 m (reachable per hand).
           Left side (world y>0): hold_1,3,5,7,9.  Right side (world y<0): hold_2,4,6,8,10. -->
      <!-- left z=0.5 -->
      <body name="hold_1" pos="-0.1 -0.005 0.5"><site name="hold_1_site" pos="0 -0.04 0" size="0.01" type="sphere" rgba="0 1 0 1"/>
        <geom name="rung_1" type="cylinder" fromto="-0.09 -0.04 0  0.09 -0.04 0" size="0.012" material="rung_material" class="world_collision"/></body>
      <!-- right z=0.5 -->
      <body name="hold_2" pos="0.2 -0.005 0.5"><site name="hold_2_site" pos="0 -0.04 0" size="0.01" type="sphere" rgba="0 1 0 1"/>
        <geom name="rung_2" type="cylinder" fromto="-0.09 -0.04 0  0.09 -0.04 0" size="0.012" material="rung_material" class="world_collision"/></body>
      <!-- left z=0.7 -->
      <body name="hold_3" pos="-0.1 -0.005 0.7"><site name="hold_3_site" pos="0 -0.04 0" size="0.01" type="sphere" rgba="0 1 0 1"/>
        <geom name="rung_3" type="cylinder" fromto="-0.09 -0.04 0  0.09 -0.04 0" size="0.012" material="rung_material" class="world_collision"/></body>
      <!-- right z=0.7 -->
      <body name="hold_4" pos="0.2 -0.005 0.7"><site name="hold_4_site" pos="0 -0.04 0" size="0.01" type="sphere" rgba="0 1 0 1"/>
        <geom name="rung_4" type="cylinder" fromto="-0.09 -0.04 0  0.09 -0.04 0" size="0.012" material="rung_material" class="world_collision"/></body>
      <!-- left z=0.9 -->
      <body name="hold_5" pos="-0.1 -0.005 0.9"><site name="hold_5_site" pos="0 -0.04 0" size="0.01" type="sphere" rgba="0 1 0 1"/>
        <geom name="rung_5" type="cylinder" fromto="-0.09 -0.04 0  0.09 -0.04 0" size="0.012" material="rung_material" class="world_collision"/></body>
      <!-- right z=0.9 -->
      <body name="hold_6" pos="0.2 -0.005 0.9"><site name="hold_6_site" pos="0 -0.04 0" size="0.01" type="sphere" rgba="0 1 0 1"/>
        <geom name="rung_6" type="cylinder" fromto="-0.09 -0.04 0  0.09 -0.04 0" size="0.012" material="rung_material" class="world_collision"/></body>
      <!-- left z=1.1 -->
      <body name="hold_7" pos="-0.1 -0.005 1.1"><site name="hold_7_site" pos="0 -0.04 0" size="0.01" type="sphere" rgba="0 1 0 1"/>
        <geom name="rung_7" type="cylinder" fromto="-0.09 -0.04 0  0.09 -0.04 0" size="0.012" material="rung_material" class="world_collision"/></body>
      <!-- right z=1.1 -->
      <body name="hold_8" pos="0.2 -0.005 1.1"><site name="hold_8_site" pos="0 -0.04 0" size="0.01" type="sphere" rgba="0 1 0 1"/>
        <geom name="rung_8" type="cylinder" fromto="-0.09 -0.04 0  0.09 -0.04 0" size="0.012" material="rung_material" class="world_collision"/></body>
      <!-- left z=1.3 -->
      <body name="hold_9" pos="-0.1 -0.005 1.3"><site name="hold_9_site" pos="0 -0.04 0" size="0.01" type="sphere" rgba="0 1 0 1"/>
        <geom name="rung_9" type="cylinder" fromto="-0.09 -0.04 0  0.09 -0.04 0" size="0.012" material="rung_material" class="world_collision"/></body>
      <!-- right z=1.3 -->
      <body name="hold_10" pos="0.2 -0.005 1.3"><site name="hold_10_site" pos="0 -0.04 0" size="0.01" type="sphere" rgba="0 1 0 1"/>
        <geom name="rung_10" type="cylinder" fromto="-0.09 -0.04 0  0.09 -0.04 0" size="0.012" material="rung_material" class="world_collision"/></body>
    </body>
    </body>
  </worldbody>

  <!-- The torso and upper-arm links must NOT collide with rungs (only the gripper hooks
       should). Otherwise the body jams against a rung instead of hanging from the hooks. -->
  <contact>
    <!-- ONLY the gripper hooks (assembly_12 / assembly_11) may touch rungs.
         Everything else passes freely so the base/arms never jam on a rung. -->
    <exclude body1="robot_base_tilted" body2="hold_1"/>
    <exclude body1="robot_base_tilted" body2="hold_2"/>
    <exclude body1="robot_base_tilted" body2="hold_3"/>
    <exclude body1="robot_base_tilted" body2="hold_4"/>
    <exclude body1="robot_base_tilted" body2="hold_5"/>
    <exclude body1="robot_base_tilted" body2="hold_6"/>
    <exclude body1="robot_base_tilted" body2="hold_7"/>
    <exclude body1="robot_base_tilted" body2="hold_8"/>
    <exclude body1="robot_base_tilted" body2="hold_9"/>
    <exclude body1="robot_base_tilted" body2="hold_10"/>
    <exclude body1="assembly_9" body2="hold_1"/>
