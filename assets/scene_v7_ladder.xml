    <exclude body1="part_4_2" body2="hold_9"/>
    <exclude body1="part_4_2" body2="hold_10"/>
  </contact>

  <equality>
    <weld name="base_anchor" body1="assembly_7" active="true"
          solref="0.02 1" solimp="0.95 0.99 0.001"/>
  </equality>
</mujoco>
