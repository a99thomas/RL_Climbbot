<mujoco model="climbbot_scene_v7">
  <include file="robot_v7.xml"/>

  <visual>
    <quality shadowsize="0"/>
    <map znear="0.01" zfar="50"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.4 0.4 0.4"/>
    <global fovy="89.16" offwidth="1280" offheight="720" azimuth="-150" elevation="-40"/>
  </visual>

  <!-- implicitfast + 2ms is stable for this stiffness; softened contacts below -->
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

  <default>
    <!-- World / wall / holds: collide with everyone. Softer solref (>=2*dt) and grippier
         tangential friction so a hook can catch and bear load instead of sliding off. -->
    <default class="world_collision">
      <geom material="collision_material" condim="4" contype="1" conaffinity="15" priority="2"
            solref="0.01 1" solimp="0.97 0.999 0.0005" friction="2.0 0.1 0.05"/>
    </default>
  </default>

  <compiler angle="radian"/>

  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="wall_material" rgba="0.6 0.6 0.6 1"/>

    <mesh name="hold_0" file="convex_parts/wall_part_0.stl"/>
    <mesh name="hold_1" file="convex_parts/wall_part_1.stl"/>
    <mesh name="hold_2" file="convex_parts/wall_part_2.stl"/>
    <mesh name="hold_3" file="convex_parts/wall_part_3.stl"/>

    <material name="hold_material" rgba="0.8 0.2 0.2 1"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" pos="0 0 0" friction="1.0"/>

    <body name="climbing_wall" pos="0 0 0" euler="-1.57 1.57 0">
    <body name="climbing_wall_tilted" pos="0 0 0" euler="1.57 0 0">
      <!-- thick backboard: front face stays at y=-0.005 (holds unchanged), body extends back -->
      <geom name="wall_board" type="box" size="1.0 0.05 1.5" pos="0 0.045 1.5"
            material="wall_material" class="world_collision"/>

      <body name="hold_1" pos="-0.1 -0.005 0.5">
        <site name="hold_1_site" pos="0.0 -0.05 0.02" size="0.01" type="sphere" rgba="0 1 0 1"/>
        <geom type="mesh" mesh="hold_0" material="hold_material" class="world_collision"/>
        <geom type="mesh" mesh="hold_1" material="hold_material" class="world_collision"/>
        <geom type="mesh" mesh="hold_2" material="hold_material" class="world_collision"/>
        <geom type="mesh" mesh="hold_3" material="hold_material" class="world_collision"/>
      </body>

      <body name="hold_2" pos="0.2 -0.005 0.7">
        <site name="hold_2_site" pos="0.0 -0.05 0.02" size="0.01" type="sphere" rgba="0 1 0 1"/>
        <geom type="mesh" mesh="hold_0" material="hold_material" class="world_collision"/>
        <geom type="mesh" mesh="hold_1" material="hold_material" class="world_collision"/>
        <geom type="mesh" mesh="hold_2" material="hold_material" class="world_collision"/>
        <geom type="mesh" mesh="hold_3" material="hold_material" class="world_collision"/>
      </body>

      <body name="hold_3" pos="-0.1 -0.005 0.9">
        <site name="hold_3_site" pos="0.0 -0.05 0.02" size="0.01" type="sphere" rgba="0 1 0 1"/>
        <geom type="mesh" mesh="hold_0" material="hold_material" class="world_collision"/>
        <geom type="mesh" mesh="hold_1" material="hold_material" class="world_collision"/>
        <geom type="mesh" mesh="hold_2" material="hold_material" class="world_collision"/>
        <geom type="mesh" mesh="hold_3" material="hold_material" class="world_collision"/>
      </body>

      <body name="hold_4" pos="0.2 -0.005 1.1">
        <site name="hold_4_site" pos="0.0 -0.05 0.02" size="0.01" type="sphere" rgba="0 1 0 1"/>
        <geom type="mesh" mesh="hold_0" material="hold_material" class="world_collision"/>
        <geom type="mesh" mesh="hold_1" material="hold_material" class="world_collision"/>
        <geom type="mesh" mesh="hold_2" material="hold_material" class="world_collision"/>
        <geom type="mesh" mesh="hold_3" material="hold_material" class="world_collision"/>
      </body>

      <body name="hold_5" pos="-0.1 -0.005 1.3">
        <site name="hold_5_site" pos="0.0 -0.05 0.02" size="0.01" type="sphere" rgba="0 1 0 1"/>
        <geom type="mesh" mesh="hold_0" material="hold_material" class="world_collision"/>
        <geom type="mesh" mesh="hold_1" material="hold_material" class="world_collision"/>
        <geom type="mesh" mesh="hold_2" material="hold_material" class="world_collision"/>
        <geom type="mesh" mesh="hold_3" material="hold_material" class="world_collision"/>
      </body>

      <body name="hold_6" pos="0.2 -0.005 1.5">
        <site name="hold_6_site" pos="0.0 -0.05 0.02" size="0.01" type="sphere" rgba="0 1 0 1"/>
        <geom type="mesh" mesh="hold_0" material="hold_material" class="world_collision"/>
        <geom type="mesh" mesh="hold_1" material="hold_material" class="world_collision"/>
        <geom type="mesh" mesh="hold_2" material="hold_material" class="world_collision"/>
        <geom type="mesh" mesh="hold_3" material="hold_material" class="world_collision"/>
      </body>
    </body>
    </body>
  </worldbody>

  <!-- Stage-0 curriculum: anchor the torso to the world at its spawn pose so the policy
       can learn the reach+hook primitive on a stable base. The env toggles this weld
       OFF (data.eq_active) for free-climbing stages. This is NOT a hook->hold weld;
       grasping is always physical contact/friction. -->
  <equality>
    <weld name="base_anchor" body1="assembly_7" active="true"
          solref="0.02 1" solimp="0.95 0.99 0.001"/>
  </equality>
</mujoco>
